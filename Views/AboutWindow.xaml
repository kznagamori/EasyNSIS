<Window x:Class="EasyNSIS.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About EasyNSIS"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}"
                    CornerRadius="12,12,0,0" Padding="24,20">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <!-- App Icon -->
                        <Border Width="56" Height="56" CornerRadius="8"
                                Background="{DynamicResource PrimaryBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="28" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="EasyNSIS" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="VersionText" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            FontSize="12" Padding="8"
                            Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel>
                    <!-- Author Info -->
                    <Border Background="{DynamicResource SidebarBackgroundBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Author Information" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Author:"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CompanyText"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Copyright:"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CopyrightText"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Version:"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FileVersionText"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Third Party Licenses -->
                    <TextBlock Text="Third-Party Licenses" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="This application uses the following open-source libraries:"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12"/>

                    <!-- License Items -->
                    <ItemsControl x:Name="LicenseList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SidebarBackgroundBrush}"
                                        CornerRadius="8" Margin="0,0,0,8">
                                    <Expander IsExpanded="False" Padding="0">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LicenseType}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <Border Background="{DynamicResource BackgroundBrush}"
                                                CornerRadius="0,0,8,8" Padding="16">
                                            <TextBox Text="{Binding LicenseText, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     FontFamily="Consolas"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     MaxHeight="200"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </Border>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- .NET Runtime -->
                    <Border Background="{DynamicResource SidebarBackgroundBrush}"
                            CornerRadius="8" Padding="16" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text=".NET Runtime" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="This application is built with .NET 10 and WPF (Windows Presentation Foundation)."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="Licensed under the MIT License."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="24,16,24,20">
                <Button Content="Close" Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White"
                        Padding="24,10" FontSize="13"
                        Cursor="Hand"/>
            </Border>
        </Grid>
    </Border>
</Window>

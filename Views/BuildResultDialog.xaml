<Window x:Class="EasyNSIS.Views.BuildResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="480"
        SizeToContent="Height"
        MinHeight="200"
        MaxHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBackgroundBrush}"
                    CornerRadius="12,12,0,0" Padding="24,20">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <!-- Success/Error Icon -->
                        <Border x:Name="IconBorder" Width="48" Height="48" CornerRadius="24"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="IconText" FontSize="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="MessageText" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="320" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button x:Name="CloseXButton" Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="12" Padding="8"
                            Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Border Grid.Row="1" Padding="24,16">
                <StackPanel x:Name="OutputPathPanel">
                    <TextBlock Text="Output Location" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource SidebarBackgroundBrush}" CornerRadius="6" Padding="12">
                        <TextBlock x:Name="OutputPathText" FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Padding="24,16,24,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            Padding="20,10" FontSize="13" FontWeight="SemiBold"
                            Margin="0,0,12,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="OpenFolderButtonText" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click"
                            Background="Transparent"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Padding="20,10" FontSize="13"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
